# La API (carpeta api/, PHP + MySQL) no se configura aquí: sus credenciales
# de base de datos van en api/config.php (copia api/config.example.php).
# En desarrollo local, si ejecutas el servidor PHP en un puerto distinto al
# proxy por defecto de Vite, ajusta VITE_API_PROXY_TARGET en vite.config.js
# o exporta la variable de entorno del mismo nombre antes de "npm run dev".
